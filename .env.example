# ============================================================
# NetMedic AI - environment configuration template
# Copy to `.env` (project root) and adjust. NEVER commit `.env`.
# Read by the backend (pydantic-settings) and by docker compose.
# ============================================================

# ---- Ports (docker compose) ----
# Change these if 8000/3000 are taken on your machine. No rebuild needed.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Backend ----
NETMEDIC_HOST=0.0.0.0
NETMEDIC_PORT=8000
NETMEDIC_LOG_LEVEL=INFO
# Simulation tick interval in seconds (telemetry update rate)
NETMEDIC_TICK_SECONDS=1.5
# SQLite database location (relative to backend/)
NETMEDIC_DATABASE_URL=sqlite:///./data/netmedic.db
# Exact origins allowed to call the API (comma-separated) plus an optional regex.
# Leave these commented out: docker compose derives both from FRONTEND_PORT (localhost,
# 127.0.0.1 and any host on that port for LAN/port-forward access), and setting them here
# would pin CORS to a fixed port. Uncomment only to override, and keep them in sync with
# FRONTEND_PORT. The backend defaults (uvicorn without compose) cover localhost:3000.
#NETMEDIC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#NETMEDIC_CORS_ORIGIN_REGEX=^https?://[^/]+:3000

# ---- AI explanation provider ----
# One of: mock | qualcomm
NETMEDIC_AI_PROVIDER=mock
# Qualcomm Cloud AI Playground settings (only used when provider=qualcomm).
# Supplied by you from the Qualcomm platform - nothing is hardcoded in the code.
# BASE_URL must be the full chat/completions endpoint URL. The request shape is
# assumed to be OpenAI-style chat completions (see backend/app/ai/qualcomm.py);
# if all three values are not set the backend falls back to the mock provider.
QUALCOMM_AI_BASE_URL=
QUALCOMM_AI_API_KEY=
QUALCOMM_AI_MODEL=
QUALCOMM_AI_TIMEOUT_SECONDS=20

# ---- Frontend ----
# Leave empty: the browser derives the backend address from its own location and
# BACKEND_PORT (works for localhost, 127.0.0.1 and LAN access alike). Set these only
# when the API runs on a different host than the dashboard.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_URL=
