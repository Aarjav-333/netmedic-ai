# ============================================================
# NetMedic AI - environment configuration template
# Copy to `.env` (project root) and adjust. NEVER commit `.env`.
# Read by the backend (pydantic-settings) and by docker compose.
# ============================================================

# ---- Ports (docker compose) ----
# Change these if 8000/3000 are taken on your machine. No rebuild needed.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Backend ----
NETMEDIC_HOST=0.0.0.0
NETMEDIC_PORT=8000
NETMEDIC_LOG_LEVEL=INFO
# Simulation tick interval in seconds (telemetry update rate)
NETMEDIC_TICK_SECONDS=1.5
# Pin the telemetry RNG for reproducible runs (the test suite sets it). Leave unset in
# production so every run produces a different-looking healthy baseline.
#NETMEDIC_RANDOM_SEED=1337

# SQLite database location (relative to backend/)
NETMEDIC_DATABASE_URL=sqlite:///./data/netmedic.db
# Exact origins allowed to call the API (comma-separated) plus an optional full-matched
# regex. The API has no authentication, so every allowed origin can also drive the
# simulation - keep this as narrow as the demo needs and never widen the regex to
# `https?://[^/]+:<port>` (that would let any site on that port use a visitor's browser
# to reach this API). Both values apply to the WebSocket handshake too.
#
# docker compose sets both from FRONTEND_PORT, so leave them commented unless you are
# overriding; keep them in sync with FRONTEND_PORT if you do. The values below are what
# compose uses for port 3000, and are also handy for `uvicorn` without compose, where the
# backend's own default covers localhost/127.0.0.1/[::1] on :3000 but no LAN address.
#NETMEDIC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000
#NETMEDIC_CORS_ORIGIN_REGEX=https?://(localhost|\[::1\]|127\.\d{1,3}\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|[A-Za-z0-9-]+\.local):3000

# ---- AI explanation provider ----
# One of: mock | qualcomm
NETMEDIC_AI_PROVIDER=mock
# Qualcomm Cloud AI Playground settings (only used when provider=qualcomm).
# Supplied by you from the Qualcomm platform - nothing is hardcoded in the code.
# BASE_URL must be the full chat/completions endpoint URL. The request shape is
# assumed to be OpenAI-style chat completions (see backend/app/ai/qualcomm.py);
# if all three values are not set the backend falls back to the mock provider.
QUALCOMM_AI_BASE_URL=
QUALCOMM_AI_API_KEY=
QUALCOMM_AI_MODEL=
QUALCOMM_AI_TIMEOUT_SECONDS=20

# ---- Frontend ----
# Leave empty: the browser derives the backend address from its own location and
# BACKEND_PORT (works for localhost, 127.0.0.1 and LAN access alike). Set these only
# when the API runs on a different host than the dashboard.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_URL=
