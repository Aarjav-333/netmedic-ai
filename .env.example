# ============================================================
# NetMedic AI - environment configuration template
# Copy to `.env` and fill in values. NEVER commit `.env`.
# ============================================================

# ---- Backend ----
NETMEDIC_HOST=0.0.0.0
NETMEDIC_PORT=8000
NETMEDIC_LOG_LEVEL=INFO
# Simulation tick interval in seconds (telemetry update rate)
NETMEDIC_TICK_SECONDS=1.5
# SQLite database location (relative to backend/)
NETMEDIC_DATABASE_URL=sqlite:///./data/netmedic.db
# Comma-separated list of allowed CORS origins for the frontend
NETMEDIC_CORS_ORIGINS=http://localhost:3000

# ---- AI explanation provider ----
# One of: mock | qualcomm
NETMEDIC_AI_PROVIDER=mock
# Qualcomm Cloud AI Playground settings (only used when provider=qualcomm).
# Supplied by you from the Qualcomm platform - nothing is hardcoded in the code.
# BASE_URL must be the full chat/completions endpoint URL. The request shape is
# assumed to be OpenAI-style chat completions (see backend/app/ai/qualcomm.py);
# if all three values are not set the backend falls back to the mock provider.
QUALCOMM_AI_BASE_URL=
QUALCOMM_AI_API_KEY=
QUALCOMM_AI_MODEL=
QUALCOMM_AI_TIMEOUT_SECONDS=20

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/network
